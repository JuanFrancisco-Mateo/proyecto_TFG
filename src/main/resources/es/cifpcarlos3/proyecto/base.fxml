<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.Image?>
<BorderPane fx:id="borderPane" prefHeight="305.0" prefWidth="456.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.cifpcarlos3.proyecto.Controladores.BaseControlador">

    <top>
        <HBox fx:id="menuSuperior" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <ImageView fx:id="imgLogo" fitHeight="80" fitWidth="80" preserveRatio="true" >
                    <image>
                        <Image url="@img/logo.jpg" />
                    </image>
            </ImageView>

            <Label alignment="CENTER" text="CENTRO DE BUCEO" />

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <MenuButton fx:id="menuUsuario" >
                <items>
                    <MenuItem text="Perfil" onAction="#verPerfil"/>
                    <MenuItem text="Cerrar sesión" onAction="#cerrarSesion"/>
                </items>
                </MenuButton>

            </HBox>

        </HBox>
    </top>

    <left>
        <VBox fx:id="menuLateral" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label fx:id="btnInicio" text="Inicio" onMouseClicked="#irInicio"/>
            <Label fx:id="btnReservas" text="Nueva reserva" onMouseClicked="#irReservas"/>
            <Label fx:id="btnClientes" text="Clientes" onMouseClicked="#irClientes"/>
            <MenuButton fx:id="btnAdministracion" text="Administración">
                <items>
                    <MenuItem text="Usuarios" onAction="#irUsuarios"/>
                    <MenuItem text="Instructores" onAction="#irInstructores"/>
                </items>
            </MenuButton>
        </VBox>
    </left>

    <center >
        <AnchorPane fx:id="contenido" BorderPane.alignment="CENTER"
                    maxWidth="Infinity"
                    maxHeight="Infinity"/>
    </center>

</BorderPane>
